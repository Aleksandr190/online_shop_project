# Используем легковесный образ Node.js на базе Linux Alpine
FROM node:20-alpine
# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app
# Копируем списки зависимостей для кеширования Docker-слоев
COPY package*.json /app/
# Устанавливаем все npm-пакеты (зависимости фронтенда)
RUN npm install
# Копируем весь исходный код проекта в контейнер
COPY . /app/
# Информируем Docker, что приложение внутри контейнера использует порт 5173
EXPOSE 5173
# Запускаем сервер разработки Vite с доступом для внешних запросов
CMD ["npm", "run", "dev", "--", "--host"]