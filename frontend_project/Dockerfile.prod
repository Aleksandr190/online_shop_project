# --- Этап 1: Сборка исходного кода приложения ---
# Используем легковесный образ Node.js на базе Linux Alpine для компиляции проекта
FROM node:20-alpine AS builder
# Устанавливаем рабочую директорию внутри контейнера сборщика
WORKDIR /app
# Копируем списки зависимостей для эффективного кеширования слоев
COPY package*.json ./
# Устанавливаем все npm-пакеты (зависимости фронтенда)
RUN npm install
# Копируем весь исходный код проекта в контейнер сборщика
COPY . .
# Собираем оптимизированный production-код (генерирует статику в папку /app/dist)
RUN npm run build
# --- Этап 2: Запуск готового веб-сервера Nginx ---
# Используем стабильный и легковесный образ веб-сервера Nginx
FROM nginx:stable-alpine
# Копируем скомпилированную статику из первого этапа в корневую папку раздачи Nginx
COPY --from=builder /app/dist /usr/share/nginx/html
# Заменяем дефолтную конфигурацию Nginx на собственный файл настроек проекта
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Информируем Docker, что веб-сервер внутри контейнера слушает стандартный порт 80
EXPOSE 80
# Запускаем Nginx на переднем плане (главным процессом), чтобы контейнер не завершал работу
CMD ["nginx", "-g", "daemon off;"]